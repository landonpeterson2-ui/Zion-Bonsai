{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "zion-bonsai",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "zion-bonsai"
    }
  ],
  // Website sign-ups (task 61). Migrations live in migrations/.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zion-bonsai-signups",
      "database_id": "b52028ca-161a-4ed0-8565-e590e629ba3f",
      "migrations_dir": "migrations"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  // Logs in the dashboard, to see which requests hit the free plan's CPU limit.
  "observability": { "enabled": true }
}
